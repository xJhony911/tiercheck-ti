# ===========================================================================
# TierCheck TI - variables de entorno (EJEMPLO, sin claves reales)
#
# 1. Copie este archivo como ".env.local" (en la raíz del proyecto).
# 2. Pegue su clave de Gemini en GEMINI_API_KEY.
# 3. Reinicie el servidor (npm run dev / npm start).
#
# ".env.local" está en .gitignore: NUNCA lo suba al repositorio.
# La clave solo la lee el servidor (rutas /api/ai/*); jamás llega al navegador.
# ===========================================================================

# Clave de la API de Gemini (obtenga una en https://aistudio.google.com/apikey).
# Si queda vacía, la plataforma funciona igual, sin personalización con IA.
GEMINI_API_KEY=

# Modelo de Gemini a utilizar (opcional). Por defecto: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
